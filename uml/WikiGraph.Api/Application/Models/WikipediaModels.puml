@startuml
'
' Detailed per-file layout for readable subdiagram renders.
!theme mars
scale max 1024*768
top to bottom direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundCorner 6
skinparam ranksep 120
skinparam nodesep 120
skinparam padding 10
skinparam WrapWidth 520
skinparam DefaultFontSize 12
skinparam ClassFontSize 13
skinparam ClassAttributeFontSize 11
skinparam ClassStereotypeFontSize 10
skinparam ArrowFontSize 10
skinparam classAttributeIconSize 0
hide empty members
class WikiSection <<sealed>> <<record>> {
    + Heading : string <<get>> <<init>>
    + Content : string <<get>> <<init>>
    + Anchor : string? <<get>> <<init>> = null
}
class WikiMatch <<sealed>> <<record>> {
    + ChunkId : string <<get>> <<init>>
    + Section : string <<get>> <<init>>
    + Text : string <<get>> <<init>>
    + SourceUrl : string <<get>> <<init>>
    + Score : double <<get>> <<init>>
}
class WikiTopicReference <<sealed>> <<record>> {
    + Title : string <<get>> <<init>>
    + SourceUrl : string <<get>> <<init>>
    + Summary : string <<get>> <<init>>
}
class WikiLookupPlan <<sealed>> <<record>> {
    + SearchQuery : string <<get>> <<init>>
}
class WikiArticle <<sealed>> {
    + WikiArticle(title:string, sourceUrl:string)
    + Title : string <<get>> <<set>>
    + SourceUrl : string <<get>> <<set>>
    + Summary : string <<get>> <<set>>
    + ArticleId : string <<get>>
    + <<override>> ToString() : string
}
class TextTools <<static>> {
    + {static} Clean(value:string?) : string
    + {static} ExtractTerms(text:string, maxTerms:int) : IReadOnlyList<string>
    + {static} Slugify(value:string) : string
    + {static} Hash(text:string) : string
    + {static} TrimToLength(text:string, maxLength:int) : string
    - {static} AddCurrentTerm(current:StringBuilder, terms:List<string>) : void
}
class "IReadOnlyList`1"<T> {
}
class "List`1"<T> {
}
WikiLookupPlan --> "FocusPhrases<string>" "IReadOnlyList`1"
WikiArticle o-> "RetrievedUtc" DateTime
WikiArticle o-> "RelatedArticles<string>" "List`1"
WikiArticle o-> "RelatedTopicDetails<WikiTopicReference>" "List`1"
WikiArticle o-> "Sections<WikiSection>" "List`1"
@enduml
