@startuml
'
' Detailed per-file layout for horizontal subdiagram renders.
!theme mars
scale max 1024*768
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundCorner 6
skinparam ranksep 80
skinparam nodesep 50
skinparam padding 6
skinparam WrapWidth 520
skinparam DefaultFontSize 12
skinparam ClassFontSize 13
skinparam ClassAttributeFontSize 11
skinparam ClassStereotypeFontSize 10
skinparam ArrowFontSize 10
skinparam classAttributeIconSize 0
hide empty members
class SessionMemoryDb <<sealed>> {
    + <<const>> DefaultUserId : string = "local-device"
    + SessionMemoryDb(connectionFactory:ISqliteConnectionFactory)
    - InitializeSchema() : void
    - {static} EnsureColumn(connection:SqliteConnection, tableName:string, columnName:string, columnDefinition:string) : void
}
SessionMemoryDb --> "_connectionFactory" ISqliteConnectionFactory
@enduml
