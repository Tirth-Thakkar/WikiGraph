@startuml
'
' Detailed per-file layout for horizontal subdiagram renders.
!theme mars
scale max 1024*768
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundCorner 6
skinparam ranksep 80
skinparam nodesep 50
skinparam padding 6
skinparam WrapWidth 520
skinparam DefaultFontSize 12
skinparam ClassFontSize 13
skinparam ClassAttributeFontSize 11
skinparam ClassStereotypeFontSize 10
skinparam ArrowFontSize 10
skinparam classAttributeIconSize 0
hide empty members
class ApiClient <<sealed>> {
    + ApiClient(httpClient:HttpClient)
    + <<async>> GetSessionsAsync(cancellationToken:CancellationToken) : Task<IReadOnlyList<SessionSummary>>
    + <<async>> CreateSessionAsync(request:CreateSessionRequest, cancellationToken:CancellationToken) : Task<SessionSummary>
    + <<async>> DeleteSessionAsync(sessionId:string) : Task<string>
    + GetSessionAsync(sessionId:string, cancellationToken:CancellationToken) : Task<SessionDetailDto?>
    + <<async>> GetGraphsAsync(sessionId:string, cancellationToken:CancellationToken) : Task<IReadOnlyList<GraphDto>>
    + <<async>> AddArticleAsync(sessionId:string, request:AddWikiArticleRequest, cancellationToken:CancellationToken) : Task<SessionDetailDto?>
}
ApiClient --> "_httpClient" HttpClient
@enduml
