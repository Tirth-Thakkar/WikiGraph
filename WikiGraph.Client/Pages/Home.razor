@page "/"

@* Injecting Dependencies into the Frontend, Navigation Manager is responsible for having prompt sumbission redirect to session pages,
   ApiClient is responsible for handling communication with the backend (https requests etc )*@
@inject ApiClient ApiClient
@inject NavigationManager PromptRedirect

<PageTitle>WikiGraph</PageTitle>

<section class="card">
    <div class="hero-header">
        <h1>Prompt to have a comprehensive summary of a topic</h1>
        @* DemoPrompt *@
        <div class="hero-actions">
            <button class="send" @onclick="RunDemo" disabled="@isBusy">Try demo prompt</button>
            <p class="api-note">Client API target <code>http://localhost:5052</code></p>
        </div>
  </div>
</section>

<PromptBar 
    Prompt="@prompt"
    PromptChanged="OnPromptChanged"
    WikiUrl="@wikiUrl"
    WikiUrlChanged="OnSourceUrlChanged"
    Busy="isBusy"
    ErrorMsg="@errorMessage"
    OnSubmit="SubmitPrompt" />

@code {
    @* Variables needed for Session Creation *@
    private string? selectedSessionId;
    private bool isBusy;
    private string? errorMessage;
    private string prompt = string.Empty;
    private string wikiUrl = string.Empty;

    @* Use this Sumbit Prompt as a new Session Id  *@
    private async Task SubmitPrompt()
    {
        @* Check to see if prompt exists If not do nothing*@
        if (string.IsNullOrWhiteSpace(prompt) && string.IsNullOrWhiteSpace(wikiUrl))
        {
            return;
        }

        await RunBusyStateAsync(async() =>
        {
            @* Session Created Here *@
            var sessionId = await EnsureSelectedSessionAsync();
            var cleanPrompt = prompt.Trim();
            var cleanUrl = wikiUrl.Trim();

            if(string.IsNullOrWhiteSpace(cleanUrl) && string.IsNullOrWhiteSpace(cleanPrompt)) {return;}
            
            var newPrompt = await ApiClient.AddArticleAsync(sessionId, 
            new AddWikiArticleRequest(cleanPrompt, cleanUrl));

            prompt = string.Empty;
            wikiUrl = string.Empty;
            @* redirect to correct Session with *@
            PromptRedirect.NavigateTo($"Sessions/"+sessionId);

        });
    }

    private async Task RunDemo()
    {
        prompt = "Climate adaptation";
        wikiUrl = string.Empty;
        await SubmitPrompt();
    }

    private Task OnPromptChanged(string value)
    {
        prompt = value;
        return Task.CompletedTask;
    }

    private Task OnSourceUrlChanged(string value)
    {
        wikiUrl = value;
        return Task.CompletedTask;
    }

    private async Task<string> EnsureSelectedSessionAsync()
    {
        @* If string is empty or Null just return the session id *@
        if (!string.IsNullOrWhiteSpace(selectedSessionId))
        {
            return selectedSessionId;
        }

        @* String used to Infer Title *@
        var titleSeed = string.IsNullOrWhiteSpace(prompt) ? wikiUrl : prompt;
        var session = await ApiClient.CreateSessionAsync(new CreateSessionRequest(InferTitle(titleSeed)));
        selectedSessionId = session.SessionId;
        return session.SessionId;
    }

    private async Task RunBusyStateAsync(Func<Task> action)
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            errorMessage = "Unable to reach the WikiGraph API. Start the backend on http://localhost:5052 and try again.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string InferTitle(string value)
    {   
        @* tries to create a Uri where the uri variable is the result*@
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri))
        {
            @* if uri Creation sucessful get the last URI Segment and show *@
            var segment = uri.Segments.LastOrDefault()?.Trim('/');
            @* if String is not Null get a new cleaned string *@
            if (!string.IsNullOrWhiteSpace(segment))
            {
                value = Uri.UnescapeDataString(segment.Replace('_', ' '));
            }
        }
        @* Split the String (removes empty values and white space as well) and then return the infered title *@
        var title = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(5);
        return string.Join(' ', title).Trim() is { Length: > 0 } result ? result : "New session";
    }
}
