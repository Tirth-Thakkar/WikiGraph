
@using System.Security
@using System.Data.SqlTypes
@using WikiGraph.Client.Pages
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

<nav class="nav">
    @foreach(SessionSummary session in SessionSummaries){
        <div class = nav-item>
            <NavLink  class = "nav-pill" href="@($"/Sessions/{session.SessionId}")">@session.Title</NavLink>
        </div>
    
        
   
    }   
</nav>

@code{

    private bool delete = false;

    public List<SessionSummary> SessionSummaries = [];
    protected override async Task OnInitializedAsync(){

        NavigationManager.LocationChanged += LocationChanged;
        await LoadSessions();
    } 
    protected async Task LoadSessions(){
        SessionSummaries.Clear();
        IReadOnlyList<SessionSummary>? sessions = await ApiClient.GetSessionsAsync();
        SessionSummaries.AddRange(sessions);
    } 

    async void LocationChanged(object? sender, LocationChangedEventArgs e){
        await LoadSessions();
        StateHasChanged();

    }

    private async void DeleteSession(string sessionId){

    }

}